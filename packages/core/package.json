{
  "name": "@scriptcable/core",
  "version": "0.1.0",
  "description": "scriptcable core — profile generation, scriptc toolchain, WASM loader, contract hashing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/scriptcable.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/scriptcable/issues"
  },
  "homepage": "https://github.com/loopy-lim/scriptcable#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm-loader.d.ts",
      "import": "./dist/wasm-loader.js"
    },
    "./toolchain": {
      "types": "./dist/toolchain.d.ts",
      "import": "./dist/toolchain.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./native": {
      "types": "./dist/native-loader.d.ts",
      "import": "./dist/native-loader.js"
    },
    "./link": {
      "types": "./dist/link-shared.d.ts",
      "import": "./dist/link-shared.js"
    },
    "./wasi": {
      "types": "./dist/wasi-polyfill.d.ts",
      "import": "./dist/wasi-polyfill.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/"
  },
  "dependencies": {
    "@scriptcable/types": "workspace:*",
    "node-api-headers": "^1.9.0",
    "typescript": "^5.9.2",
    "@babel/runtime": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
