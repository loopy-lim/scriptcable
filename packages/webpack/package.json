{
  "name": "@scriptcable/webpack",
  "version": "0.1.0",
  "description": "Webpack / Rspack / Rsbuild plugin for scriptcable",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@scriptcable/core": "workspace:*",
    "@scriptcable/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
