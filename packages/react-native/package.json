{
  "name": "@scriptcable/react-native",
  "version": "0.1.0",
  "description": "React Native adapter \u2014 typed bridge to a scriptcable native module",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metro": {
      "types": "./dist/metro.d.ts",
      "import": "./dist/metro.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/"
  },
  "dependencies": {
    "@scriptcable/core": "workspace:*",
    "@scriptcable/types": "workspace:*",
    "@babel/runtime": "^8.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
