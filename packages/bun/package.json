{
  "name": "@scriptcable/bun",
  "version": "0.1.0",
  "description": "Bun adapter \u2014 native via bun:ffi by default; scriptc WASM (WASI) opt-in",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@scriptcable/bun: no tests (skip)\""
  },
  "dependencies": {
    "@scriptcable/core": "workspace:*",
    "@scriptcable/types": "workspace:*",
    "@scriptcable/node": "workspace:*"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
