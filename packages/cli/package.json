{
  "name": "@scriptcable/cli",
  "version": "0.1.0",
  "description": "scriptcable CLI \u2014 init, build, codegen, contract diff, doctor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "scriptcable": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@scriptcable/core": "workspace:*",
    "@scriptcable/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
