{
  "name": "@scriptca/example-next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "pnpm --filter @scriptca/example-calculator-core exec scriptca build --target both && node -e \"import('@scriptca/next').then(m=>m.scriptcaBuild())\"",
    "test:server": "pnpm build:core && node --experimental-strip-types src/server-action.ts",
    "build": "pnpm build:core && node ./scripts/fake-next-build.mjs",
    "test": "pnpm test:server && pnpm build"
  },
  "dependencies": {
    "@scriptca/next": "workspace:*",
    "@scriptca/core": "workspace:*",
    "@scriptca/node": "workspace:*",
    "@scriptca/types": "workspace:*"
  },
  "devDependencies": {
    "scriptc": "^0.3.6",
    "@scriptc/runtime-wasm32-wasi": "^0.3.6"
  }
}
