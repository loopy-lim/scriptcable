{
  "name": "@scriptcable/example-react-native-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "bun run --filter @scriptcable/example-calculator-core build",
    "build:hosts": "bunx --bun scriptcable build --hosts react-native",
    "test": "bun run build:core && bun test src/",
    "test:metro": "bun run build:core && bun run build:hosts && bun scripts/metro-bundle.mjs",
    "test:expo": "bun run build:core && bun run build:hosts && bun scripts/expo-bundle.mjs"
  },
  "dependencies": {
    "@scriptcable/react-native": "workspace:*"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.7",
    "@expo/metro-config": "^58.0.0",
    "@react-native/metro-config": "^0.88.0",
    "@scriptcable/types": "workspace:*",
    "expo": "^58.0.16",
    "metro": "^0.87.1",
    "react": "^19.3.1",
    "react-native": "^0.88.0"
  }
}
