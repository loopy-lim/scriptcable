{
  "name": "@scriptcable/example-vite-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "scriptcable build --target both --hosts browser,node",
    "dev": "bun run build:core && bun --bun vite",
    "build": "bun run build:core && bun --bun vite build",
    "test:ssr": "bun run build:core && bun src/ssr.ts",
    "test:wasm": "bun run build:core && bun src/wasm-smoke.ts",
    "test": "bun run test:ssr && bun run test:wasm && bun run test:dropin && bun run build",
    "test:dropin": "bun src/dropin-smoke.ts"
  },
  "dependencies": {
    "@scriptcable/core": "workspace:*",
    "@scriptcable/node": "workspace:*",
    "@scriptcable/example-calculator-core": "workspace:*",
    "@scriptcable/types": "workspace:*"
  },
  "devDependencies": {
    "@scriptcable/cli": "workspace:*",
    "@scriptcable/vite": "workspace:*",
    "scriptc": "^0.3.6",
    "@scriptc/runtime-wasm32-wasi": "^0.3.6",
    "vite": "^6.0.0"
  }
}
