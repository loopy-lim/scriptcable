{
  "name": "scriptcable",
  "version": "0.1.0",
  "private": true,
  "description": "One TypeScript core (compiled by scriptc) → type-safe clients for Bun, Node, Deno, Tauri, React Native, Lynx, Cloudflare Workers, Vite, and Next.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "test:e2e:node": "bun run --filter @scriptcable/example-node-app start",
    "test:e2e:bun": "bun run --filter @scriptcable/example-bun-app start",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "clean": "rm -rf packages/*/dist packages/*/dist-test examples/*/.scriptcable examples/*/node_modules/.cache",
    "postbuild": "bun install --silent"
  },
  "devDependencies": {
    "@scriptc/runtime-wasm32-wasi": "^0.4.0",
    "@types/bun": "^1.3.0",
    "enhanced-resolve": "^5.26.0",
    "scriptc": "^0.4.0",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "scriptc",
    "@scriptc/runtime-wasm32-wasi",
    "electron"
  ]
}
